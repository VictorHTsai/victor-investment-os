# Phase 1 uses MockLLMProvider and requires no API keys.
# VICTOR_LLM_PROVIDER=mock
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional free Alpaca Basic market-data credentials. When absent, Phase 2
# equity/ETF requests fall back to the no-key Yahoo chart adapter.
# ALPACA_API_KEY_ID=
# ALPACA_API_SECRET_KEY=
